GITHUB_USERNAME=your-github-username
# Required for pinned repositories on the homepage (GitHub GraphQL). Without a token, repo list falls back to top stars.
GITHUB_TOKEN="op://<vault>/<item-github>/token"
GITHUB_CACHE_TTL=1h

# Do not set this to a page that renders Lighthouse results.
LIGHTHOUSE_URL=https://valery-kh.vercel.app/resume
PAGESPEED_API_KEY="op://<vault>/<item-pagespeed>/token"

# https://<organization>.sentry.io/settings/projects/<project-id>/keys/
SENTRY_DSN=