# Copied to `.env` for local dev. `make run` runs `set -a && . ./.env` (see Makefile).

# Listen port (optional — defaults to 8080 if unset). Fly sets PORT for you.
# PORT=8080

# GET /github/stats — username required; token optional but helps rate limits.
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=your-github-token
# Optional cache lifetime (Go duration), e.g. 1h, 30m
GITHUB_CACHE_TTL=1h

# GET /lighthouse — Google PageSpeed fetches SITE_URL from their network; it must respond within Lighthouse's load budget.
# Trap: SITE_URL=https://yoursite/ when "/" server-renders and awaits your own /lighthouse (this API) — PageSpeed is
# still loading "/" while "/" is blocked on PageSpeed → very slow or FAILED_DOCUMENT_REQUEST / ERR_TIMED_OUT.
# Use a path that doesn't block on /lighthouse during SSR (e.g. /resume); scores are for that URL.
SITE_URL=https://example.com

# Optional — PageSpeed Insights API key (higher quota). Omit to use the free tier behavior.
# PAGESPEED_API_KEY=
